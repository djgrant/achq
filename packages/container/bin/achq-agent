#!/bin/sh
# Entry point. A platform may mount the volume root-owned, so when started as
# root this hands the volume to the `agent` user and re-runs itself as that
# user. Agents such as Claude refuse to skip permission prompts as root.
set -eu

data=${DATA_DIR:-/data}
if [ "$(id -u)" = 0 ]; then
  mkdir -p "$data"
  chown agent:agent "$data"
  # The image's WORKDIR may be unreadable to `agent` (oven/bun's is /home/bun/app).
  cd "$data"
  exec setpriv --reuid=agent --regid=agent --init-groups env HOME="$data/home" "$0" "$@"
fi
exec bun "$(dirname "$(readlink -f "$0")")/../src/main.ts" "$@"
